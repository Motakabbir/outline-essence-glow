<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect HTTP to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 1. Directly serve existing files inside the client folder
  # This avoids redirecting files with any extension length (like .woff2, .webmanifest)
  RewriteCond %{DOCUMENT_ROOT}/dist/client/$1 -f
  RewriteRule ^(.*)$ /dist/client/$1 [L]

  # 2. Route page requests to their prerendered index.html if it exists
  # Works for both with and without trailing slash, avoiding mod_dir directory redirects
  # E.g. /about or /about/ -> serves dist/client/about/index.html
  RewriteCond %{DOCUMENT_ROOT}/dist/client/$1/index.html -f
  RewriteRule ^(.*[^/])$ /dist/client/$1/index.html [L]

  RewriteCond %{DOCUMENT_ROOT}/dist/client/$1index.html -f
  RewriteRule ^(.*)/$ /dist/client/$1index.html [L]

  # 3. Route root request / to the client index
  RewriteRule ^$ /dist/client/index.html [L]

  # 4. Fallback to index.html for client-side (SPA) routing of un-prerendered routes
  RewriteCond %{DOCUMENT_ROOT}/dist/client/$1 !-f
  RewriteCond %{DOCUMENT_ROOT}/dist/client/$1 !-d
  RewriteRule ^(.*)$ /dist/client/index.html [L]
</IfModule>
